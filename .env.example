# Set one or both providers. Switch at the prompt with /provider groq | /provider gemini
GROQ_API_KEY=
# GEMINI_API_KEY=                          # aistudio.google.com/apikey. Free tier content may be used to improve Google's products
# KAPPA_PROVIDER=groq                      # which one to start with (default: the first one with a key)
# KAPPA_GROQ_MODEL=openai/gpt-oss-120b
# KAPPA_GEMINI_MODEL=gemini-3.7-flash

# GROQ_BASE_URL=http://localhost:<port>/v1   # point the groq slot at any other OpenAI-compatible server (e.g. OmniRoute)
# TAVILY_API_KEY=tvly-...                 # reliable web search (free tier at tavily.com). Without it, DuckDuckGo scraping is used and may hit bot checks
# KAPPA_MODEL=openai/gpt-oss-120b
# KAPPA_HOME=C:\Users\you\.kappa          # db, logs, scripts, run folders
# KAPPA_FS_ROOTS=C:\Users\you;D:\         # folders Kappa may touch (';' on Windows, ':' elsewhere). Default: home + temp
# KAPPA_REASONING=low                     # gpt-oss only: low | medium | high. Lower uses far fewer tokens
# KAPPA_MAX_ITERATIONS=15
# KAPPA_PYTHON=python